# ============================================================================
# MAU BIEN MOI TRUONG WEB DASHBOARD (ENVIRONMENT VARIABLES TEMPLATE)
# Huong dan su dung:
# 1. Sao chep file nay thanh "web/.env.local"
# 2. Dien day du thong tin Azure / Firebase cua ban vao file "web/.env.local"
# 3. File .env.local da duoc .gitignore bao ve, tuyet doi khong bi commit len Git.
# ============================================================================

# Azure IoT Hub
VITE_AZURE_IOTHUB_NAME=iothub-tuoicay-hkp
VITE_AZURE_DEVICE_ID=esp32-garden-01
VITE_AZURE_PRIMARY_KEY=YOUR_PRIMARY_KEY_HERE

# Firebase Project Config
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
